# /etc/agentanywhere.env (mode 0600, owner root). Read by agentanywhere.service.
PORT=8790
AA_HOST=127.0.0.1
AA_TRUST_PROXY=1
AA_DATA_DIR=/opt/agentanywhere/data

# The server secret and Ed25519 signing key are generated on first start and kept in
# AA_DATA_DIR (mode 0600). Back that directory up; losing the signing key signs every bridge out.

# Email verification. Local development defaults to console (codes appear in service logs).
# Alibaba Cloud DirectMail: use the endpoint for the sender's console region.
# smtpdm.aliyun.com:465 is China (Hangzhou), implicit TLS; no new dependency required.
AA_EMAIL_SENDER=console
# AA_EMAIL_SENDER=smtp
# AA_SMTP_URL=smtps://<发信地址，@ 写成 %40>:<SMTP 密码>@smtpdm.aliyun.com:465
# URL-encode BOTH the sender address and SMTP password (especially @, :, /, %, #).
# Use the SMTP password set for the sender, not an Alibaba Cloud login password/AccessKey.
# AA_MAIL_FROM=AgentAnywhere <发信地址>
# Product owner feedback notifications (sent only when AA_EMAIL_SENDER=smtp).
# AA_FEEDBACK_EMAIL=

# Temporary migration only: 1 permits existing phone+password accounts to sign in.
# Phone registration stays disabled. Bind email before switching back to 0.
AA_LEGACY_PHONE_LOGIN=0

# APNs task notifications. Missing/unreadable key configuration disables push only.
# Directory: /etc/agentanywhere, root:agentanywhere 0750.
# Auth key: /etc/agentanywhere/apns.p8, root:agentanywhere 0640 (never commit it).
# AA_APNS_KEY_FILE=/etc/agentanywhere/apns.p8
# AA_APNS_KEY_ID=YOUR_KEY_ID
# AA_APNS_TEAM_ID=YOUR_TEAM_ID
# AA_APNS_BUNDLE_ID=com.deanhilarious.agentanywhere

# Test only: explicitly override an origin with a local h2c HTTP/2 server.
# Leave unset in production; defaults are Apple's sandbox/production HTTPS endpoints.
# AA_APNS_ORIGIN_SANDBOX=http://127.0.0.1:9001
# AA_APNS_ORIGIN_PRODUCTION=http://127.0.0.1:9002
